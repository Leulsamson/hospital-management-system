import PatientsTable from "@/components/patients/patients-table";
import { requireDashboardSession } from "@/lib/dashboard-auth";
import { prisma } from "@/lib/prisma";

export default async function PatientsPage() {
  await requireDashboardSession(["ADMIN", "RECEPTIONIST", "DOCTOR", "NURSE"]);

  const [total, data, departments] = await Promise.all([
    prisma.patient.count({ where: { isActive: true } }),
    prisma.patient.findMany({
      where: { isActive: true },
      include: {
        department: { select: { id: true, name: true } },
      },
      orderBy: { createdAt: "desc" },
      take: 10,
    }),
    prisma.department.findMany({ where: { isActive: true }, orderBy: { name: "asc" }, select: { id: true, name: true } }),
  ]);

  return (
    <main className="min-h-screen px-4 py-6 md:px-8">
      <div className="mx-auto w-full max-w-7xl space-y-5">
        <header className="card-soft rounded-3xl p-6">
          <p className="text-xs font-semibold tracking-[0.2em] text-[var(--brand)]">PHASE 4</p>
          <h1 className="mt-2 text-3xl font-semibold">Patient Management</h1>
          <p className="mt-2 text-sm text-soft">
            Registration, search, filtering, profile navigation, editing, and deactivation workflows.
          </p>
        </header>

        <PatientsTable
          initialResult={{
            success: true,
            data,
            departments,
            meta: {
              total,
              page: 1,
              pageSize: 10,
              totalPages: Math.max(1, Math.ceil(total / 10)),
            },
          }}
        />
      </div>
    </main>
  );
}
